# Agent host (copy into agent/.env; never commit values)
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
CARTESIA_AGENT_ID=
CARTESIA_PHONE_NUMBER_ID=
CARTESIA_PHONE_NUMBER=
# Filled automatically by the local demo launcher
CARTESIA_SELF_HOSTED_URL=
APIFY_TOKEN=
APIFY_WALMART_ACTOR=
APIFY_TIMEOUT_SECONDS=
# auto (live Apify when configured, else cache) or fixtures (demo: always cached results)
SEARCH_MODE=
CONVEX_SITE_URL=
AGENT_SECRET=
# Convex and Cartesia alert tool: different random secrets, at least 32 characters
ALERT_SECRET=
ALERT_AGENT_ID=
ALERT_FROM_NUMBER_ID=
ALERT_RING_TIMEOUT_SECONDS=
CARTESIA_API_VERSION=
CLAUDE_MODEL_CONVERSATION=
CLAUDE_EFFORT_CONVERSATION=
CLAUDE_MODEL_SCAM=
CLAUDE_EFFORT_SCAM=
CLAUDE_MODEL_MEMORY=
CLAUDE_EFFORT_MEMORY=
# Wait before answering when the caller stops on a filler or unfinished phrase (ms, 0 = off; default 700)
END_OF_TURN_HOLDOFF_MS=
# Say "One moment." when a reply has no text after this many ms (0 turns it off).
SLOW_REPLY_MS=1800
# Silence (#15): waits in ms before "Take your time.", the reassurance line, then a gentle hang-up
SILENCE_STEPS_MS=
# Cartesia voice for every call (#30), sent per call in the pre-call config. Unset = defaults in agent/voice.py
# (Michelle, speed 0.9); set empty to keep the Cartesia agent's own voice / speed
CARTESIA_VOICE_ID=
CARTESIA_VOICE_SPEED=
# Convex payment rail: mock (default) or visa; MOCK_PAYMENT_FAIL=1 forces a mock decline
PAYMENT_RAIL=
MOCK_PAYMENT_FAIL=
# Visa Intelligent Commerce (Convex env; PEM contents, not paths). See docs/visa.md
VISA_API_KEY=
VISA_SHARED_SECRET=
VISA_MLE_SERVER_CERT_PEM=
VISA_MLE_PRIVATE_KEY_PEM=
VISA_MLE_KEY_ID=
VISA_EXTERNAL_CLIENT_ID=
VISA_EXTERNAL_APP_ID=
VISA_CONSUMER_ID=
VISA_TOKEN_ID=
VISA_API_BASE_URL=
VISA_CERT_PEM=
VISA_KEY_PEM=
VISA_USER_ID=
VISA_PASSWORD=
CLERK_JWT_ISSUER_DOMAIN=
# Dashboard demo access (Convex env): random key of at least 32 characters; optional demo household phone
DASHBOARD_ACCESS_KEY=
DASHBOARD_HOUSEHOLD_PHONE=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=
# Demo seed: use team phones in E.164, never real older adults' data
DEMO_CALLER_PHONE=
DEMO_FAMILY_PHONE=
DEMO_FAMILY_AUTH_SUBJECT=
# Optional Twilio voice-call test harness
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Milestone 7 stretch (optional)
# #60 check-in calls. Convex env: the Cartesia agent id of this Errand Line agent, and the
# outbound number id (falls back to ALERT_FROM_NUMBER_ID). Agent env: that number in E.164,
# so the agent recognizes a call it placed even without call metadata.
CHECKIN_AGENT_ID=
CHECKIN_FROM_NUMBER_ID=
CHECKIN_FROM_NUMBER=
# #67 Spanish handoff (agent env): a Spanish Cartesia voice id (empty keeps the same voice);
# SPANISH_HANDOFF=0 turns the handoff off.
CARTESIA_VOICE_ID_ES=
SPANISH_HANDOFF=
